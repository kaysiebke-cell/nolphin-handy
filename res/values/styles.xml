<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Hell und dunkel folgen dem System; Farben der Leisten kommen aus colors.xml -->
    <style name="NolphinTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/bar_bg</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
    </style>
    <!-- Einheitliche Dialoge: Mint-Akzent, runde Ecken, Farben wie die App -->
    <style name="NolphinDialog" parent="android:Theme.DeviceDefault.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/dialog_accent</item>
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="android:textColorSecondary">@color/dialog_text2</item>
        <item name="android:textColor">@color/dialog_text</item>
    </style>
</resources>
