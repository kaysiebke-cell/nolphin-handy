<?xml version="1.0" encoding="utf-8"?>
<!-- Nolphin Handy: Empfänger und Sender für den Handy-Austausch von Nolphin.
     Nur das Android-Framework, keine Bibliotheken. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.nolphin.handy"
    android:versionCode="48"
    android:versionName="4.30">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Zum Aktualisieren der App aus der Version, die Nolphin am PC bereithält. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Nur für das Foto-Raster im Reiter „Zum PC“; wird erst dort angefragt. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Für den Dateimanager im Reiter „Zum PC“: alle Ordner des Handys und der SD-Karte durchsuchen. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Namen und Symbole der Apps im Ordner „Apps“ (Reiter „Zum PC“). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Der Austausch läuft unverschlüsselt (HTTP) im eigenen WLAN. -->
    <application
        android:label="Nolphin Handy"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/NolphinTheme"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Verknüpfung „QR-Code scannen“ (lange auf das App-Symbol drücken) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- nolphin://connect?…: Verbindungslink (Version 2, mit Fingerabdruck) zum Öffnen der App. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nolphin" />
            </intent-filter>
        </activity>

        <!-- Scannt den QR-Code von Nolphin mit der Kamera (eigener QR-Leser, keine Bibliothek). -->
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.DayNight"
            android:screenOrientation="portrait" />

        <!-- Eintrag im Teilen-Menü: Dateien an den PC senden. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Nolphin (PC)"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <receiver android:name=".Updater$Result" android:exported="false" />

        <!-- Startbildschirm-Widget (exportiert, damit das System es aktualisieren kann; es nimmt nur Systemaktualisierungen an) -->
        <receiver android:name=".NolphinWidget" android:exported="true" android:label="Nolphin Handy kompakt">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <receiver android:name=".NolphinWidgetLarge" android:exported="true" android:label="Nolphin Handy erweitert">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info_large" />
        </receiver>
        <!-- Schaltflächen des Widgets, die den Dienst steuern: nicht exportiert -->
        <receiver android:name=".WidgetActions" android:exported="false" />

        <!-- gibt einzelne Dateien an andere Apps heraus (Öffnen mit, Bearbeiten mit); nur mit ausdrücklicher Berechtigung -->
        <provider
            android:name=".FilesProvider"
            android:authorities="org.nolphin.handy.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
